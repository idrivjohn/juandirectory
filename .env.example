# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Database
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=juandirectory
DB_USER=root
DB_PASSWORD=

# Logging
LOG_LEVEL=debug

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file

# Mail
